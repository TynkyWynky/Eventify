# Most frontend defaults now live in `src/config/appConfig.ts` so Vercel does not
# need matching UI env vars for normal deploys. Create `.env` only if you want to
# override those checked-in defaults locally or for a specific environment.

# Local backend (default in local dev if unset)
# VITE_API_BASE_URL=http://localhost:3000

# If you intentionally want the frontend to call a different deployed backend,
# keep this off by default and opt in explicitly.
# VITE_API_BASE_URL_ALLOW_CROSS_ORIGIN=true

# Optional frontend overrides
# VITE_EVENTS_REPO_MODE=api
# VITE_DEFAULT_LAT=50.8503
# VITE_DEFAULT_LNG=4.3517
# VITE_EVENTS_FETCH_SIZE=240
# VITE_EVENTS_FETCH_TIMEOUT_MS=15000
# VITE_EVENTS_CACHE_TTL_MS=60000
# VITE_EVENTS_INCLUDE_SCRAPED=1
# VITE_EVENTS_PREFER_DB_FIRST=1
# VITE_EVENTS_ALLOW_LIVE_FETCH=1
# VITE_ENABLE_SW=false
